# ─── Banco de Dados MySQL ───────────────────────────────────
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root

AUTH_DB_PASSWORD=auth_dev_change_me
PROFILE_DB_PASSWORD=profile_dev_change_me
CAMPAIGNS_DB_PASSWORD=campaigns_dev_change_me
LEDGER_DB_PASSWORD=ledger_dev_change_me
PRIZES_DB_PASSWORD=prizes_dev_change_me
DAILY_CHEST_DB_PASSWORD=daily_chest_dev_change_me

# ─── Kafka ──────────────────────────────────────────────────
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_UI_PORT=8088
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Segurança ──────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production-min-32-chars-ok
JWT_EXPIRATION_HOURS=24
INTERNAL_API_KEY=dev-internal-api-key-change-me

# ─── Portas dos Serviços ────────────────────────────────────
AUTH_SERVICE_PORT=8081
PROFILE_SERVICE_PORT=8082
CAMPAIGNS_SERVICE_PORT=8083
LEDGER_SERVICE_PORT=8084
PRIZES_SERVICE_PORT=8085
DAILY_CHEST_SERVICE_PORT=8086
BFF_SERVICE_PORT=8090
WEB_APP_PORT=3000

# ─── Admin de seed (criado no arranque do auth-service) ─────
AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@coupons.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin123
AUTH_BOOTSTRAP_ADMIN_NAME=Admin
# E-mails extras (já existentes) promovidos a ADMIN, separados por vírgula
AUTH_BOOTSTRAP_ADMIN_EMAILS=
# Utilizadores comuns de demo (richard@gmail.com / lucas@gmail.com)
AUTH_BOOTSTRAP_DEMO_USERS_ENABLED=true

# ─── Observabilidade ───────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ─── Seed de demonstração (empresas + campanha) ─────────────
CAMPAIGNS_DEMO_SEED_ENABLED=true
CAMPAIGNS_DEMO_SEED_POINTS_COST=10

# ─── Tracing (OpenTelemetry → Jaeger) ───────────────────────
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
